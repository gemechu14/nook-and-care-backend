
# App
APP_NAME="Nook and Care API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# Database (dev SQLite)
#  DATABASE_URL=sqlite:///./dev.db

# Database (prod PostgreSQL - uncomment):
DATABASE_URL=postgresql://postgres:pass1@localhost:5432/nookandcare

# Security - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
