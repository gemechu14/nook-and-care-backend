# Nook and Care Backend â€” Environment Variables
# Copy this file to .env and fill in the values.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# App
APP_NAME="Nook and Care API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# Database â€” PostgreSQL (recommended for production)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nookandcare

# For SQLite (development only â€” comment out PostgreSQL line above and uncomment below):
# DATABASE_URL=sqlite:///./dev.db

# SQLAlchemy â€” Set to true to see all SQL queries in logs (useful for debugging)
SQL_ECHO=false

# Security - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
